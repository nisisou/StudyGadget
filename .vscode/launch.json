{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Study Gadget: ボタン付きVS Codeを開く",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/tools/vscode-extension",
        "${workspaceFolder}"
      ]
    }
  ]
}
